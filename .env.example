OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# auto | on | off — hybrid dense+TF-IDF retrieval
VERTEX_EMBEDDINGS=auto
VERTEX_HYBRID_ALPHA=0.65
VERTEX_HYBRID_BETA=0.35
VERTEX_REACT_MAX_STEPS=5
VERTEX_MIN_EVIDENCE=2
VERTEX_MIN_CONFIDENCE=0.1
VERTEX_CACHE_DIR=.cache
